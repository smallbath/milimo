:root {
    --color-bg: #0d0d0d;
    --color-bg-light: #1a1a1a;
    --color-bg-lighter: #252525;
    --color-text: #d4d4d4;
    --color-text-secondary: #8a8a8a;
    --color-accent: #d4a574;
    --color-accent-tint: rgba(212, 165, 116, 0.1);
    --color-accent-dim: #b8875a;
    --color-torch: rgba(255, 180, 100, 0.15);

    --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-fast: all 0.2s ease;

    --max-width: 900px;
    --max-width-projects: 1700px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    font-weight: 300;
    overflow-x: hidden;
    position: relative;
    background-image:
        radial-gradient(circle at 20% 30%, rgba(50, 40, 30, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(40, 30, 25, 0.04) 0%, transparent 50%);
}

::selection {
    background-color: var(--color-accent-tint);
    color: var(--color-accent);
}

#torchCanvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
}

.hidden-objects {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
}

.hidden-object {
    position: absolute;
    color: var(--color-accent);
    opacity: 0.05;
    transition: opacity 0.8s ease;
}

.main-content {
    width: 100%;
    min-height: 100vh;
}

.section {
    min-height: 85vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
}

.container,
.container-narrow {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 60px 0;
}

.container-narrow {
    max-width: var(--max-width-projects);
}

.hero-section {
    flex-direction: column;
    text-align: center;
    min-height: 100vh;
}

.hero-content {
    max-width: 800px;
    width: 100%;
    position: relative;
    z-index: 2;
    margin: 0 auto;
}

.hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    margin-bottom: 24px;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
}

.highlight {
    color: var(--color-accent);
    position: relative;
}

.hero-subtitle {
    font-size: clamp(1.25rem, 3vw, 2rem);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    font-weight: 300;
}

.hero-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 48px;
    max-width: 600px;
    line-height: 1.7;
    margin-left: auto;
    margin-right: auto;
}

.cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background: transparent;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
    font-size: 1rem;
    transition: var(--transition-smooth);
    position: relative;
}

.cta-button:hover {
    background: var(--color-accent-tint);
    transform: translateY(-2px);
}

.cta-button svg {
    transition: var(--transition-fast);
}

.cta-button:hover svg {
    transform: translateX(4px);
}

.section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    margin-bottom: 48px;
    letter-spacing: -0.02em;
    position: relative;
    display: inline-block;
    color: var(--color-text);
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 2px;
}

.section-title.centered {
    display: block;
    text-align: center;
}

.section-title.centered::after {
    left: 50%;
    transform: translateX(-50%);
}



.about-content .large-text {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 32px;
    color: var(--color-accent);
    line-height: 1.6;
}

.about-content p {
    margin-bottom: 24px;
    color: var(--color-text-secondary);
    line-height: 1.8;
}

.skills-section {
    margin-top: 64px;
}

.skills-section h3 {
    font-size: 1.5rem;
    margin-bottom: 32px;
    font-weight: 600;
    color: var(--color-text);
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 32px;
}







.skill-tag:hover {
    background: rgba(212, 165, 116, 0.15);
    border-color: var(--color-accent);
    transform: translateY(-2px);
}

.work-section {
    align-items: center;
    text-align: center;
}

.projects-list {
    display: flex;
    flex-direction: column;
    gap: 100px;
}

.project-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    max-width: 1300px;
    margin: 0 auto;
}

.project-image {
    flex: 0 0 62%;
    position: relative;
    z-index: 1;
}

.project-item.reverse .project-image {
    order: 2;
}

.project-image-wrapper {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg-light);
    aspect-ratio: 16 / 9;
    box-shadow: 0 10px 40px -15px rgba(0, 0, 0, 0.5);
    transition: var(--transition-smooth);
}

.project-image-wrapper:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px -15px rgba(212, 165, 116, 0.3);
}

.project-image-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(212, 165, 116, 0.1);
    transition: var(--transition-smooth);
    pointer-events: none;
    mix-blend-mode: multiply;
}

.project-item:hover .project-image-wrapper::after {
    background: transparent;
}

.project-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: var(--transition-smooth);
    filter: grayscale(0.3) contrast(1.1);
}

.project-item:hover .project-image-wrapper img {
    filter: grayscale(0) contrast(1);
}

.static-image {
    opacity: 1;
}

.animated-image {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
}

.project-item:hover .static-image {
    opacity: 0;
}

.project-item:hover .animated-image {
    opacity: 1;
}

.project-content {
    flex: 0 0 42%;
    margin-left: -4%;
    position: relative;
    z-index: 2;
    text-align: right;
    padding: 0;
}

.project-item.reverse .project-content {
    order: 1;
    margin-left: 0;
    margin-right: -4%;
    text-align: left;
}

.project-overline {
    color: var(--color-accent);
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    font-weight: 400;
    margin-bottom: 8px;
}

.project-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 20px;
    line-height: 1.3;
}

.project-description-card {
    background: var(--color-bg-light);
    border-radius: 6px;
    padding: 24px 28px;
    margin: 0 0 16px 0;
    max-width: 440px;
    margin-left: auto;
    box-shadow: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
    transition: var(--transition-smooth);
    text-align: left;
}

.project-description-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px -15px rgba(2, 12, 27, 0.9);
}

.project-description-card p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
}

.project-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    margin-bottom: 16px;
    justify-content: right;
}

.project-item.reverse .project-tech-list {
    justify-content: left;
}

.project-tech-list li {
    color: var(--color-text-secondary);
    font-family: 'Courier New', monospace;
    font-size: 0.8125rem;
    white-space: nowrap;
}

.project-links {
    display: flex;
    gap: 16px;
    justify-content: right;
}

.project-item.reverse .project-links {
    justify-content: left;
}

.project-links a {
    color: var(--color-text-secondary);
    transition: var(--transition-fast);
}

.project-links a:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
}





.contact-text {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
}



.contact-info-photo {
    margin-bottom: 8px;
}

.photo-placeholder-large {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-tint), var(--color-bg-lighter));
    border: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.photo-placeholder-large::before {
    content: '';
    position: absolute;
    width: 40px;
    height: 40px;
    background: var(--color-accent);
    border-radius: 50%;
    top: 25%;
    opacity: 0.3;
}

.photo-placeholder-large::after {
    content: '';
    position: absolute;
    width: 80px;
    height: 80px;
    background: var(--color-accent);
    border-radius: 50%;
    bottom: -30%;
    opacity: 0.3;
}











.fixed-contact-section {
    position: fixed;
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    z-index: 100;
    transition: opacity 0.4s ease, visibility 0.4s ease;
}

.fixed-contact-section a {
    color: var(--color-text-secondary);
    opacity: 0.55;
    transition: var(--transition-fast);
    display: inline-flex;
}

.fixed-contact-section a:hover {
    color: var(--color-accent);
    opacity: 1;
    transform: translateX(-3px);
}

.fixed-contact-section.hidden {
    opacity: 0;
    visibility: hidden;
}

.fixed-contact-photo {
    margin: 0;
    padding-right: 9px;
}

.photo-placeholder {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-tint), var(--color-bg-lighter));
    border: 2px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: var(--transition-smooth);
}

.photo-placeholder::before {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--color-accent);
    border-radius: 50%;
    top: 25%;
    opacity: 0.3;
}

.photo-placeholder::after {
    content: '';
    position: absolute;
    width: 40px;
    height: 40px;
    background: var(--color-accent);
    border-radius: 50%;
    bottom: -30%;
    opacity: 0.3;
}

.photo-placeholder:hover {
    transform: scale(1.1);
    border-color: var(--color-accent-dim);
}



.fixed-contact-link:hover {
    color: var(--color-accent);
}





.fixed-contact-icons a:hover {
    color: var(--color-accent);
    transform: translateY(-3px);
}



.footer-credit {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-family: 'Courier New', monospace;
}

@media (max-width: 1024px) {
    .fixed-contact-section {
        right: 16px;
        gap: 10px;
    }

    .project-item,
    .project-item.reverse {
        display: flex;
        flex-direction: column;
    }

    .project-image,
    .project-item.reverse .project-image {
        grid-column: 1 / -1;
        width: 100%;
        min-height: 320px;
    }

    .project-image-wrapper {
        aspect-ratio: 16 / 9;
        min-height: 320px;
    }

    .project-content,
    .project-item.reverse .project-content {
        grid-column: 1 / -1;
        text-align: center;
        width: 100%;
    }

    .project-description-card {
        background: var(--color-bg-light);
        box-shadow: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
        padding: 20px;
        margin-top: 16px;
    }

    .project-tech-list,
    .project-item.reverse .project-tech-list {
        justify-content: center;
    }

    .project-links,
    .project-item.reverse .project-links {
        justify-content: center;
    }

    .projects-list {
        gap: 80px;
    }
}

@media (max-width: 768px) {
    html {
        scroll-snap-type: none;
    }

    .section {
        padding: 0 16px;
        min-height: auto;
        scroll-snap-align: none;
        opacity: 1 !important;
    }

    .work-section {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .fixed-contact-section {
        right: 12px;
        gap: 8px;
    }

    

    .photo-placeholder {
        width: 40px;
        height: 40px;
    }

    

    .container,
    .container-narrow {
        padding: 48px 0;
    }

    .hero-section {
        min-height: 100vh;
    }

    .hero-title {
        font-size: 2.5rem;
    }

    .hero-subtitle {
        font-size: 1.25rem;
    }

    .section-title {
        font-size: 2rem;
        margin-bottom: 40px;
    }

    .skills-grid {
        grid-template-columns: 1fr;
        gap: 24px;
    }

    .project-item,
    .project-item.reverse {
        display: flex;
        flex-direction: column;
        gap: 24px;
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
    }

    .project-image,
    .project-item.reverse .project-image {
        grid-column: 1 / -1;
        width: 100%;
        min-height: auto;
    }

    .project-image-wrapper {
        aspect-ratio: 16 / 9;
        min-height: unset;
        max-width: 100%;
        width: 100%;
        border-radius: 8px;
        box-shadow: 0 15px 50px -15px rgba(212, 165, 116, 0.2);
    }

    .project-image-wrapper:hover {
        transform: none;
    }

    .project-image-wrapper img {
        object-position: center top;
        filter: grayscale(0) contrast(1);
    }

    .project-content,
    .project-item.reverse .project-content {
        grid-column: 1 / -1;
        text-align: center;
        width: 100%;
    }

    .project-description-card {
        background: rgba(26, 26, 26, 0.6);
        box-shadow: none;
        padding: 20px;
        margin-top: 16px;
        backdrop-filter: blur(10px);
    }

    .project-tech-list,
    .project-item.reverse .project-tech-list {
        justify-content: center;
    }

    .project-links,
    .project-item.reverse .project-links {
        justify-content: center;
    }

    .projects-list {
        gap: 70px;
    }

    .project-title {
        font-size: 1.5rem;
    }

    #torchCanvas,
    .hidden-objects {
        display: none;
    }
}

@media (max-width: 480px) {
    .hero-title {
        font-size: 2rem;
    }

    .hero-subtitle {
        font-size: 1.125rem;
    }

    .hero-description {
        font-size: 1rem;
    }

    .cta-button {
        padding: 14px 28px;
    }

    .fixed-contact-section {
        right: 12px;
    }

    .project-image-wrapper {
        min-height: unset;
        aspect-ratio: 16 / 9;
    }

    .project-image,
    .project-item.reverse .project-image {
        min-height: auto;
    }

    .section {
        padding: 0 12px;
    }
}



a,
button {
    transition: var(--transition-smooth);
}

/* ---- Emergency: force everything visible ---- */
.project-item,
.project-content,
.project-image,
.project-image-wrapper,
.about-section,
.contact-section,
.section {
    opacity: 1 !important;
    transform: none !important;
}


/* Fixed contact icons — small, vertical, no box */
.fixed-contact-section a {
    color: var(--color-text-secondary);
    opacity: 0.6;
    transition: var(--transition-fast);
    display: inline-flex;
}

.fixed-contact-section a:hover {
    color: var(--color-accent);
    opacity: 1;
    transform: translateX(-3px);
}


/* ---- About two-column merged ---- */
















/* ---- Contact + footer merged ---- */


.contact-container {
    max-width: 700px;
    width: 100%;
    margin: 0 auto;
}

.contact-title {
    font-size: 1.875rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
}

.contact-text {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 36px;
}

.contact-icons {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: center;
    margin-bottom: 56px;
}

.contact-icons a {
    color: var(--color-text-secondary);
    transition: var(--transition-fast);
    display: inline-flex;
}

.contact-icons a:hover {
    color: var(--color-accent);
    transform: translateY(-3px);
}

.footer-credit {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-family: 'Courier New', monospace;
    opacity: 0.7;
}

/* Mobile: stack about */
@media (max-width: 1024px) {
    
    
}


/* ---- About — left-aligned two column ---- */
.about-section {
    padding: 100px 32px 40px;
}

.about-section .container {
    max-width: 1200px;
    margin: 0 auto;
}

.about-section .section-title.centered {
    text-align: center;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-top: 20px;
}

.about-text {
    text-align: left;
}







.about-skills {
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-align: left;
}

.skill-category {
    text-align: left;
}

.skill-category h4 {
    color: var(--color-accent);
    margin-bottom: 10px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-align: left;
}

.skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-start;
}

.skill-tag {
    padding: 6px 12px;
    background: var(--color-accent-tint);
    border: 1px solid rgba(212, 165, 116, 0.2);
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-accent);
    font-family: 'Courier New', monospace;
}

/* ---- Contact + footer — tighter ---- */
.contact-footer {
    padding: 60px 32px 60px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 0;
}

.contact-container {
    max-width: 700px;
    width: 100%;
    margin: 0 auto;
}

.contact-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
}

.contact-text {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 32px;
}

.contact-icons {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: center;
    margin-bottom: 40px;
}

.contact-icons a {
    color: var(--color-text-secondary);
    transition: var(--transition-fast);
    display: inline-flex;
}

.contact-icons a:hover {
    color: var(--color-accent);
    transform: translateY(-3px);
}

.footer-credit {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-family: 'Courier New', monospace;
    opacity: 0.7;
}

@media (max-width: 1024px) {
    .about-section {
        padding: 80px 24px 30px;
    }
    .about-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    .contact-footer {
        padding: 48px 24px 48px;
    }
}


/* ---- About text — uniform paragraphs ---- */
.about-text {
    text-align: left;
}

.about-text p,
.about-text .large-text {
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 22px;
    text-align: left;
    letter-spacing: normal;
}

.about-text p:last-child {
    margin-bottom: 0;
}
